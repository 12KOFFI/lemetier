{% extends 'base_dashboard.html.twig' %}

{% block title %}Nouvelle candidature | {{ parent() }}{% endblock %}

{% set input_class = 'w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition' %}

{% macro champ(field, input_class, extra_attr = {}) %}
    <div>
        <label for="{{ field.vars.id }}" class="block mb-1.5 text-sm font-semibold text-slate-700">{{ field.vars.label }}{% if field.vars.required %}<span class="ml-0.5 text-red-600" aria-hidden="true">*</span>{% endif %}</label>
        {{ form_widget(field, {'attr': {'class': input_class}|merge(extra_attr)}) }}
        {{ form_help(field, {'help_attr': {'class': 'mt-1 text-xs text-slate-500'}}) }}
        <div class="mt-1 text-sm text-red-600">{{ form_errors(field) }}</div>
    </div>
{% endmacro %}

{% macro choix(field) %}
    <fieldset>
        <legend class="block mb-1.5 text-sm font-semibold text-slate-700">{{ field.vars.label }}{% if field.vars.required %}<span class="ml-0.5 text-red-600" aria-hidden="true">*</span>{% endif %}</legend>
        <div class="flex flex-wrap gap-3">
            {% for option in field %}
                <label class="inline-flex items-center gap-2 px-4 py-2.5 border rounded-lg cursor-pointer border-slate-300 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50">
                    {{ form_widget(option, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 focus:ring-indigo-500'}}) }}
                    <span class="text-sm text-slate-800">{{ option.vars.label }}</span>
                </label>
            {% endfor %}
        </div>
        <div class="mt-1 text-sm text-red-600">{{ form_errors(field) }}</div>
    </fieldset>
{% endmacro %}

{% macro fichier(field, deja_recu = null) %}
    {# Le bouton natif affiche « Choose File / No file chosen » dans la langue du navigateur :
       on le masque (il reste focusable au clavier) et on affiche un bouton en français. #}
    <div>
        <label for="{{ field.vars.id }}" class="block mb-1.5 text-sm font-semibold text-slate-700">{{ field.vars.label }}{% if field.vars.required %}<span class="ml-0.5 text-red-600" aria-hidden="true">*</span>{% endif %}</label>
        {# « relative » garde le champ masqué dans la zone qui défile : sinon il se place par rapport à <body>,
           agrandit la page et la fait sauter quand il reçoit le focus. #}
        <div class="fichier-case relative flex items-center gap-3 p-1.5 bg-white border rounded-lg border-slate-300 focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-transparent{{ deja_recu ? ' is-recu' }}" data-fichier-case>
            {{ form_widget(field, {'attr': {'class': 'sr-only', 'data-fichier': ''}}) }}
            <label for="{{ field.vars.id }}" class="inline-flex items-center shrink-0 gap-2 px-4 py-2 text-sm font-semibold text-indigo-700 rounded-md cursor-pointer bg-indigo-50 hover:bg-indigo-100">
                <i class="fas fa-upload" aria-hidden="true"></i> Choisir un fichier
            </label>
            <span class="fichier-nom min-w-0 text-sm text-slate-500" data-fichier-nom{% if deja_recu %} data-deja-recu="Déjà reçu : {{ deja_recu }}"{% endif %} aria-live="polite">
                <i class="fas fa-circle-check fichier-coche" aria-hidden="true"></i>
                <span class="truncate" data-fichier-texte>{{ deja_recu ? 'Déjà reçu : ' ~ deja_recu : 'Aucun fichier choisi' }}</span>
            </span>
        </div>
        {{ form_help(field, {'help_attr': {'class': 'mt-1 text-xs text-slate-500'}}) }}
        <div class="mt-1 text-sm text-red-600">{{ form_errors(field) }}</div>
    </div>
{% endmacro %}

{% macro carte(icone, titre) %}
    <h2 class="flex items-center pb-3 mb-5 text-lg font-semibold border-b text-indigo-800">
        <span class="flex items-center justify-center w-8 h-8 mr-3 bg-indigo-100 rounded-lg" aria-hidden="true"><i class="fas fa-{{ icone }} text-indigo-700"></i></span>
        {{ titre }}
    </h2>
{% endmacro %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .notification-erreurs { transform: translateX(-50%); animation: notification-entree .3s ease-out; }
        @keyframes notification-entree {
            from { transform: translate(-50%, -1rem); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }
        .fichier-case { transition: border-color .2s ease, background-color .2s ease; }
        .fichier-nom { display: flex; align-items: center; gap: .4rem; }
        .fichier-coche { display: none; flex-shrink: 0; font-size: 1.05rem; }
        .fichier-case.is-recu { border-color: #10b981; background-color: #ecfdf5; }
        .fichier-case.is-recu .fichier-nom { color: #047857; font-weight: 600; }
        .fichier-case.is-recu .fichier-coche { display: inline-block; color: #059669; }
        .fichier-case.is-refuse { border-color: #dc2626; background-color: #fef2f2; }
        .fichier-case.is-refuse .fichier-nom { color: #b91c1c; font-weight: 600; }
        .fichier-case.is-anime { animation: fichier-halo .7s ease-out; }
        .fichier-case.is-anime .fichier-coche { animation: fichier-coche .45s cubic-bezier(.34, 1.56, .64, 1); }
        @keyframes fichier-halo {
            from { box-shadow: 0 0 0 0 rgba(16, 185, 129, .5); }
            to { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        }
        @keyframes fichier-coche {
            from { transform: scale(0) rotate(-45deg); opacity: 0; }
            to { transform: scale(1) rotate(0); opacity: 1; }
        }
        @media (prefers-reduced-motion: reduce) {
            .notification-erreurs, .fichier-case, .fichier-case.is-anime, .fichier-case.is-anime .fichier-coche { animation: none; transition: none; }
        }
    </style>
{% endblock %}

{% block body %}
{% import _self as ui %}
{% if erreurs_saisie %}
    {# Notification en haut de page : reste visible jusqu'à sa fermeture #}
    <div id="notification-erreurs" role="alert" class="notification-erreurs fixed top-4 left-1/2 w-[calc(100%-2rem)] max-w-xl overflow-hidden bg-white border border-red-300 shadow-2xl rounded-xl" style="z-index: 70">
        <div class="flex items-start gap-3 p-4 border-b border-red-200 bg-red-50">
            <i class="mt-0.5 text-xl text-red-600 fas fa-circle-exclamation" aria-hidden="true"></i>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-red-800">Candidature non enregistrée</p>
                <p class="text-sm text-red-700">{{ erreurs_saisie|length }} {{ erreurs_saisie|length > 1 ? 'champs à corriger' : 'champ à corriger' }} : cliquez pour y aller.</p>
            </div>
            <button type="button" data-fermer-notification class="p-1 text-red-500 rounded hover:text-red-800" aria-label="Fermer la notification">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <ul class="overflow-y-auto divide-y max-h-64 divide-slate-100">
            {% for erreur in erreurs_saisie %}
                <li>
                    <button type="button" data-aller-champ="{{ erreur.id }}" class="w-full px-4 py-2.5 text-sm text-left hover:bg-red-50">
                        <span class="font-semibold text-slate-800">{{ erreur.champ }}</span>
                        <span class="block text-red-700">{{ erreur.message }}</span>
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
<div class="max-w-5xl mx-auto">
    <div class="p-8 mb-8 text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl">
        <h1 class="text-2xl font-bold">Nouvelle candidature</h1>
        <p class="mt-1 text-white/85">
            {% if etablissement_impose %}
                {{ etablissement_impose }} · {{ session.nom }}
            {% else %}
                {{ is_granted('ROLE_ADMIN') ? 'Saisie administrateur' : 'Saisie agent DAIP' }} · {{ session.nom }}
            {% endif %}
        </p>
        <p class="mt-3 text-sm text-white/80">Remplissez la fiche avec le candidat présent et ses pièces originales. Son compte de connexion est créé en même temps que la candidature.</p>
    </div>

    <p class="mb-4 text-sm text-slate-600">Les champs marqués d'un <span class="font-semibold text-red-600">*</span> sont obligatoires.</p>

    {% include 'partials/_flash_messages.html.twig' %}

    {{ form_start(form, {'attr': {'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}

    {% if form_errors(form) %}
        <div class="px-5 py-4 text-sm text-red-700 border border-red-300 rounded-xl bg-red-50">{{ form_errors(form) }}</div>
    {% endif %}

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('school', 'Formation') }}
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {% if form.etablissement is defined %}
                {{ ui.champ(form.etablissement, input_class) }}
            {% else %}
                <div>
                    <p class="block mb-1.5 text-sm font-semibold text-slate-700">Établissement</p>
                    <p class="px-4 py-2.5 rounded-lg bg-slate-100 text-slate-800">{{ etablissement_impose }}</p>
                </div>
            {% endif %}
            {{ ui.champ(form.metier, input_class) }}
        </div>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('user', 'Identité du candidat') }}
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {{ ui.champ(form.candidat.nom, input_class, {'autocomplete': 'off'}) }}
            {{ ui.champ(form.candidat.prenoms, input_class, {'autocomplete': 'off'}) }}
            {{ ui.choix(form.candidat.sexe) }}
            {{ ui.champ(form.candidat.datenaissance, input_class) }}
            {{ ui.champ(form.candidat.lieunaissance, input_class) }}
            {{ ui.champ(form.candidat.nationalite, input_class) }}
            {{ ui.champ(form.candidat.situationmat, input_class) }}
            {{ ui.champ(form.candidat.numextrait, input_class) }}
            {{ ui.champ(form.candidat.nompere, input_class) }}
            {{ ui.champ(form.candidat.nommere, input_class) }}
        </div>
        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.candidat) }}</div>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('id-card', 'Pièce d\'identité') }}
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {{ ui.choix(form.piece) }}
            {{ ui.champ(form.numpiece, input_class) }}
        </div>
        <p class="mt-4 text-xs text-slate-500">Le numéro est vérifié sur toutes les candidatures de la session, dans tous les établissements : un candidat ne peut s'inscrire qu'une fois.</p>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('key', 'Compte de connexion du candidat') }}
        <div class="px-4 py-3 mb-5 text-sm border rounded-lg border-amber-200 bg-amber-50 text-amber-900">
            Le candidat se connectera avec son <strong>numéro de téléphone</strong> ou son <strong>e-mail</strong> et le mot de passe choisi ici.
            Notez ces identifiants et remettez-les-lui à la fin de l'inscription.
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {{ ui.champ(form.candidat.contact, input_class) }}
            {{ ui.champ(form.candidat.email, input_class) }}
            {{ ui.champ(form.plainPassword.first, input_class) }}
            {{ ui.champ(form.plainPassword.second, input_class) }}
        </div>
        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.plainPassword) }}</div>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('house', 'Résidence et situation') }}
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {{ ui.champ(form.villeResidence, input_class) }}
            {{ ui.champ(form.quartierAdresse, input_class) }}
            {{ ui.champ(form.etucom, input_class) }}
        </div>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        {{ ui.carte('paperclip', 'Pièces du dossier') }}
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {% for champ in ['fextrait', 'fpiece', 'fphoto', 'fautre'] %}
                {% if attribute(form, champ) is defined %}
                    {{ ui.fichier(attribute(form, champ), deja_recus[champ] ?? null) }}
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="p-6 bg-white border shadow-sm md:p-8 rounded-2xl border-slate-200">
        <label class="flex items-start gap-3 cursor-pointer">
            {{ form_widget(form.declarationHonneur, {'attr': {'class': 'mt-1 w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500'}}) }}
            <span class="text-sm text-slate-800">{{ form.declarationHonneur.vars.label }}<span class="ml-0.5 text-red-600" aria-hidden="true">*</span></span>
        </label>
        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.declarationHonneur) }}</div>

        <div class="flex flex-wrap justify-end gap-3 pt-6 mt-6 border-t border-slate-200">
            <a href="{{ path('app_candidature_index') }}" class="inline-flex items-center px-6 py-2.5 border rounded-lg border-slate-300 text-slate-700 hover:bg-slate-50">Annuler</a>
            <button type="submit" class="inline-flex items-center px-6 py-2.5 font-semibold text-white bg-indigo-600 rounded-lg shadow hover:bg-indigo-700">
                <i class="mr-2 fas fa-save" aria-hidden="true"></i> Enregistrer la candidature
            </button>
        </div>
    </section>

    {{ form_widget(form._token) }}
    <input type="hidden" name="_depot" value="{{ depot }}">
    {{ form_end(form, {'render_rest': false}) }}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Notification d'erreurs : fermeture, et accès direct au champ concerné.
        document.querySelector('[data-fermer-notification]')?.addEventListener('click', function () {
            document.getElementById('notification-erreurs').remove();
        });
        document.querySelectorAll('[data-aller-champ]').forEach(function (bouton) {
            bouton.addEventListener('click', function () {
                var id = bouton.dataset.allerChamp;
                var champ = document.getElementById(id) || document.querySelector('[id^="' + id + '_"]');
                if (champ) {
                    (champ.closest('div, fieldset') || champ).scrollIntoView({ block: 'center' });
                    champ.focus({ preventScroll: true });
                }
            });
        });

        // Téléphone : uniquement des chiffres, 10 au maximum. Un numéro collé avec espaces ou +225 est nettoyé.
        document.querySelectorAll('[data-telephone]').forEach(function (input) {
            input.addEventListener('input', function () {
                var chiffres = input.value.replace(/\D/g, '');
                if (chiffres.length === 13 && chiffres.indexOf('225') === 0) {
                    chiffres = chiffres.slice(3);
                }
                chiffres = chiffres.slice(0, 10);
                if (input.value !== chiffres) {
                    input.value = chiffres;
                }
            });
        });

        // Fichier récupéré : la case passe au vert avec une coche animée. Trop lourd : en rouge, le fichier est retiré.
        var TAILLE_MAX = 2 * 1024 * 1024;
        document.querySelectorAll('[data-fichier]').forEach(function (input) {
            var cadre = input.closest('[data-fichier-case]');
            var nom = cadre.querySelector('[data-fichier-nom]');
            var texte = cadre.querySelector('[data-fichier-texte]');

            input.addEventListener('change', function () {
                var fichier = input.files && input.files[0];
                var tropLourd = !!fichier && fichier.size > TAILLE_MAX;
                if (tropLourd) {
                    input.value = '';
                }
                var recu = !!fichier && !tropLourd;
                var dejaRecu = nom.dataset.dejaRecu;

                texte.textContent = tropLourd
                    ? 'Fichier trop lourd : 2 Mo maximum'
                    : (recu ? fichier.name : (dejaRecu || 'Aucun fichier choisi'));

                cadre.classList.remove('is-recu', 'is-refuse', 'is-anime');
                if (recu || (!tropLourd && dejaRecu)) {
                    cadre.classList.add('is-recu');
                }
                if (tropLourd) {
                    cadre.classList.add('is-refuse');
                }
                if (recu) {
                    void cadre.offsetWidth; // relance l'animation si on remplace le fichier
                    cadre.classList.add('is-anime');
                }
            });
        });
    </script>
{% endblock %}
