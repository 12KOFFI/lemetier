{% extends 'base.html.twig' %}

{% block title %}Nouvelle candidature | GROUPE LEMETIER{% endblock %}

{# Définition de la classe CSS réutilisable #}
{% set input_class = 'w-full px-4 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition' %}
{% set is_edit_page = app.request.attributes.get('_route') == 'app_candidature_edit' %}

{% block body %}

{# Flash messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="mb-4 p-4 rounded-lg border
            {% if label == 'error' %}
                bg-red-50 border-red-200 text-red-800
            {% elseif label == 'success' %}
                bg-green-50 border-green-200 text-green-800
            {% else %}
                bg-blue-50 border-blue-200 text-blue-800
            {% endif %}
        ">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="p-8 mb-8 text-white bg-gradient-to-r from-indigo-600 to-purple-600">
    <div class="flex items-center gap-4 mb-4">
        <div class="flex items-center justify-center w-16 h-16 rounded-full bg-white/20">
            <i class="text-3xl fas fa-file-alt"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold">
                {% if is_edit_page %}Modification de candidature{% else %}Nouvelle candidature{% endif %}
            </h1>
            <p class="text-white/80">
                {% if is_edit_page %}Mettez a jour les informations de la candidature de facon claire et complete.{% else %}Vous etes sur le point de postuler a une formation{% endif %}
            </p>
        </div>
    </div>
    
    <!-- Informations du candidat -->
    {% if app.user %}
        {% if is_granted('ROLE_ENT') and is_edit_page and candidature is defined %}
            <div class="grid grid-cols-1 gap-4 mt-4 lg:grid-cols-2">
                <div class="p-4 border bg-white/10 backdrop-blur-sm rounded-xl border-white/20">
                    <p class="flex items-center mb-3 text-sm font-semibold text-white/80">
                        <i class="mr-2 fas fa-user-graduate"></i>
                        Informations du candidat
                    </p>
                    <div class="space-y-3">
                        <div class="px-3 py-2 rounded-lg bg-white/10">
                            <p class="text-xs tracking-wide uppercase text-white/70">Nom du candidat</p>
                            <p class="mt-1 text-sm font-semibold text-white">{{ candidature.user ? (candidature.user.nom ~ ' ' ~ candidature.user.prenoms)|trim : 'Non renseigne' }}</p>
                        </div>
                        <div class="px-3 py-2 rounded-lg bg-white/10">
                            <p class="text-xs tracking-wide uppercase text-white/70">Numero de candidature</p>
                            <p class="mt-1 text-sm font-semibold text-white">{{ candidature.numero|default('Non attribue') }}</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 border bg-white/10 backdrop-blur-sm rounded-xl border-white/20">
                    <p class="flex items-center mb-3 text-sm font-semibold text-white/80">
                        <i class="mr-2 fas fa-file-signature"></i>
                        Informations de la candidature
                    </p>
                    <div class="space-y-3">
                        <div class="px-3 py-2 rounded-lg bg-white/10">
                            <p class="text-xs tracking-wide uppercase text-white/70">Etablissement choisi</p>
                            <p class="mt-1 text-sm font-semibold text-white">{{ candidature.etablissement ? candidature.etablissement.nom : 'Non renseigne' }}</p>
                        </div>
                        <div class="px-3 py-2 rounded-lg bg-white/10">
                            <p class="text-xs tracking-wide uppercase text-white/70">Metier choisi</p>
                            <p class="mt-1 text-sm font-semibold text-white">{{ candidature.metier ? candidature.metier.nom : 'Non renseigne' }}</p>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="p-4 mt-4 bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-10 h-10 rounded-full bg-white/20">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <p class="text-sm text-white/80">Candidat</p>
                        <p class="font-semibold">{{ app.user.nom }} {{ app.user.prenoms }}</p>
                    </div>

                    {# Calcul et affichage de l'âge #}
                    {% if app.user.datenaissance %}
                        {% set age = date().diff(date(app.user.datenaissance)).y %}
                        <div class="px-3 py-1 ml-4 rounded-full bg-white/20">
                            <span class="text-sm">
                                <i class="mr-1 fas fa-birthday-cake"></i>
                                {{ age }} ans
                            </span>
                            </div>
                    {% endif %}

                    <div class="ml-auto">
                        <span class="px-3 py-1 text-sm rounded-full bg-white/20">{{ app.user.email }}</span>
                        <span class="px-3 py-1 ml-2 text-xs bg-indigo-500 rounded-full">
                            {% if is_granted('ROLE_ADMIN') %}ADMIN
                            {% elseif is_granted('ROLE_ENT') %}ENT
                            {% elseif is_granted('ROLE_JURY') %}JURY
                            {% elseif is_granted('ROLE_CANDIDAT') %}CANDIDAT
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}
    
    {# Vérification d'âge #}
    {% if app.user and app.user.datenaissance %}
        {% set age = date().diff(date(app.user.datenaissance)).y %}
        {% if age < 18 or age > 40 %}
            <div class="p-4 mt-4 border bg-red-500/20 backdrop-blur-sm border-red-500/30 rounded-xl">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-500/30">
                        <i class="text-red-300 fas fa-exclamation-triangle"></i>
                    </div>
                    <div>
                        <p class="font-semibold text-white">Âge non conforme</p>
                        <p class="text-sm text-white/80">
                            {% if age < 18 %}
                                Vous avez {{ age }} ans. L'âge minimum requis pour candidater est de 18 ans.
                            {% elseif age > 40 %}
                                Vous avez {{ age }} ans. L'âge maximum autorisé pour candidater est de 40 ans.
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>

<div class="max-w-7xl mx-auto px-4 pb-16 {{ is_edit_page ? 'pt-2' : '' }}">
    {% include 'partials/_flash_messages.html.twig' %}

    {% if is_edit_page and candidature is defined and candidature.id %}

        {# ===== PARTIE 1 : MISE À JOUR DES INFORMATIONS ===== #}
        <div class="mb-8 overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
            <div class="p-6 md:p-8">
                <div class="p-4 mb-8 border border-indigo-200 rounded-xl bg-indigo-50 md:p-5">
                    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                        <div>
                            <p class="flex items-center text-sm font-semibold text-indigo-800">
                                <i class="mr-2 fas fa-edit"></i> Partie 1 — Mise à jour des informations
                            </p>
                            <p class="mt-1 text-sm text-indigo-700">Modifiez les informations du candidat, le métier et les documents.</p>
                        </div>
                        <span class="inline-flex items-center px-3 py-1 text-sm font-semibold text-indigo-700 bg-white border border-indigo-200 rounded-full">
                            N° {{ candidature.numero|default('Non attribué') }}
                        </span>
                    </div>
                </div>

                <form id="form-update-info" action="{{ path('app_candidature_update_info', {id: candidature.id}) }}" method="POST" enctype="multipart/form-data" class="space-y-10">
                    <input type="hidden" name="_token" value="{{ csrf_token('candidature_update_info_' ~ candidature.id) }}">

                    {# Identité du candidat (ADMIN/ENT/JURY/CANDIDAT) #}
                    {% if is_granted('ROLE_ENT') or is_granted('ROLE_ADMIN') or is_granted('ROLE_JURY') or is_granted('ROLE_CANDIDAT') %}
                        <div class="p-5 border border-orange-200 rounded-xl bg-orange-50">
                            <h3 class="flex items-center mb-4 text-base font-semibold text-orange-800">
                                <div class="flex items-center justify-center mr-2 bg-orange-200 rounded-lg w-7 h-7">
                                    <i class="text-sm text-orange-700 fas fa-user-edit"></i>
                                </div>
                                Identité du candidat
                            </h3>
                            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                <div>
                                    <label class="block mb-1 text-sm font-medium text-slate-700">Nom <span class="text-red-500">*</span></label>
                                    <input type="text" name="nom" value="{{ candidature.user ? candidature.user.nom : '' }}" class="{{ input_class }}" placeholder="Nom de famille">
                                </div>
                                <div>
                                    <label class="block mb-1 text-sm font-medium text-slate-700">Prénom(s) <span class="text-red-500">*</span></label>
                                    <input type="text" name="prenoms" value="{{ candidature.user ? candidature.user.prenoms : '' }}" class="{{ input_class }}" placeholder="Prénom(s)">
                                </div>
                                <div>
                                    <label class="block mb-1 text-sm font-medium text-slate-700">Email</label>
                                    <input type="email" name="email" value="{{ candidature.user ? candidature.user.email : '' }}" class="{{ input_class }}" placeholder="exemple@domaine.com">
                                </div>
                                <div>
                                    <label class="block mb-1 text-sm font-medium text-slate-700">Contact (téléphone)</label>
                                    <input type="text" name="contact" value="{{ candidature.user ? candidature.user.contact : '' }}" class="{{ input_class }}" placeholder="Ex: 0102030405">
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {# Formation souhaitée #}
                    <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold text-indigo-800 border-b">
                        <div class="flex items-center justify-center w-8 h-8 mr-3 bg-indigo-200 rounded-lg">
                            <i class="text-indigo-700 fas fa-graduation-cap"></i>
                        </div>
                        Formation souhaitée
                    </h3>

                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Établissement <span class="text-red-500">*</span></label>
                            <div class="{{ input_class }} bg-slate-100 text-slate-600 cursor-default flex items-center gap-2">
                                <i class="text-xs fas fa-lock text-slate-400"></i>
                                {{ candidature.etablissement ? candidature.etablissement.nom : 'Non renseigné' }}
                            </div>
                            <input type="hidden" id="candidature_etablissement" value="{{ candidature.etablissement ? candidature.etablissement.id : '' }}">
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Métier <span class="text-red-500">*</span></label>
                            <select name="metier_id" id="candidature_metier" required class="{{ input_class }}">
                                {% if candidature.metier %}
                                    <option value="{{ candidature.metier.id }}" selected>{{ candidature.metier.nom }}</option>
                                {% else %}
                                    <option value="">-- Sélectionnez un métier --</option>
                                {% endif %}
                            </select>
                            <div id="metier-loading" class="hidden mt-1 text-sm text-indigo-600">
                                <i class="mr-1 fas fa-spinner fa-spin"></i> Chargement...
                            </div>
                        </div>
                    </div>

                    {# Informations détaillées du métier #}
                    <div id="metier-info" class="hidden mt-6">
                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
                            <div class="flex items-center gap-3 p-2 bg-purple-100 rounded-lg">
                                <i class="text-purple-600 fas fa-users"></i>
                                <div>
                                    <p class="text-xs text-purple-600">Places</p>
                                    <p id="metier-nbrplace" class="text-sm font-medium">-</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 p-2 bg-green-100 rounded-lg">
                                <i class="text-green-600 fas fa-graduation-cap"></i>
                                <div>
                                    <p class="text-xs text-green-600">Niveau</p>
                                    <p id="metier-niveau" class="text-sm font-medium">-</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 p-2 rounded-lg bg-amber-100">
                                <i class="fas fa-clock text-amber-600"></i>
                                <div>
                                    <p class="text-xs text-amber-600">Durée de formation</p>
                                    <p id="metier-duree" class="text-sm font-medium">-</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Documents #}
                    <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold text-purple-800 border-b">
                        <div class="flex items-center justify-center w-8 h-8 mr-3 bg-purple-200 rounded-lg">
                            <i class="text-purple-700 fas fa-cloud-upload-alt"></i>
                        </div>
                        Documents à télécharger
                    </h3>

                    {% include 'partials/_document_upload_plain.html.twig' with {
                        'candidature': candidature,
                        'document_labels': document_labels,
                        'input_class': input_class
                    } %}

                    {# Bouton Mise à jour #}
                    <div class="flex flex-col items-center justify-between gap-4 pt-6 border-t md:flex-row border-slate-200">
                        <div class="text-sm text-slate-500">
                            <i class="mr-1 fas fa-info-circle"></i>
                            Les champs marqués d'une <span class="text-red-500">*</span> sont obligatoires
                        </div>
                        <button type="submit" class="flex items-center px-8 py-2 font-semibold text-white transition transform rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 hover:scale-105">
                            <i class="mr-2 fas fa-save"></i>
                            Mise à jour des informations
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# ===== PARTIE 2 : ANALYSE DU DOSSIER (réservée au staff) ===== #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY') %}
        <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
            <div class="p-6 md:p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-10', 'id': 'candidature-form'}}) }}

                    <div class="p-4 mb-4 border rounded-xl border-amber-200 bg-amber-50 md:p-5">
                        <p class="flex items-center text-sm font-semibold text-amber-800">
                            <i class="mr-2 fas fa-clipboard-list"></i>
                            Partie 2 — Analyse du dossier
                        </p>
                        <p class="mt-1 text-sm text-amber-700">Étudiez le dossier, évaluez le candidat et enregistrez le résultat.</p>
                    </div>

                    {% include 'partials/_candidature_evaluation_sections.html.twig' %}

                    <div class="flex flex-col items-center justify-between gap-4 pt-6 border-t md:flex-row border-slate-200">
                        <div class="text-sm text-slate-500">
                            <i class="mr-1 fas fa-info-circle"></i>
                            Les champs marqués d'une <span class="text-red-500">*</span> sont obligatoires
                        </div>
                        <button type="submit" class="flex items-center px-8 py-2 font-semibold text-white transition transform rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 hover:scale-105">
                            <i class="mr-2 fas fa-paper-plane"></i>
                            Enregistrer l'évaluation
                        </button>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
        {% endif %}

    {% else %}

    <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
        <div class="p-6 md:p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-10', 'enctype': 'multipart/form-data', 'id': 'candidature-form'}}) }}

            {% if is_edit_page and candidature is defined %}
                <div class="p-4 border border-indigo-200 rounded-xl bg-indigo-50 md:p-5">
                    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                        <div>
                            <p class="text-sm font-semibold text-indigo-800">Edition de candidature</p>
                            <p class="mt-1 text-sm text-indigo-700">Verifiez les informations puis mettez a jour les documents si necessaire.</p>
                        </div>
                        <span class="inline-flex items-center px-3 py-1 text-sm font-semibold text-indigo-700 bg-white border border-indigo-200 rounded-full">
                            N° {{ candidature.numero|default('Non attribue') }}
                        </span>
                    </div>
                </div>
            {% endif %}

            {# Section : Identité du candidat (visible ENT / ADMIN en mode édition) #}
            {% if is_edit_page and (is_granted('ROLE_ENT') or is_granted('ROLE_ADMIN')) and form.nom is defined %}
                <div class="p-5 border border-orange-200 rounded-xl bg-orange-50">
                    <h3 class="flex items-center mb-4 text-base font-semibold text-orange-800">
                        <div class="flex items-center justify-center mr-2 bg-orange-200 rounded-lg w-7 h-7">
                            <i class="text-sm text-orange-700 fas fa-user-edit"></i>
                        </div>
                        Identité du candidat
                    </h3>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">
                                Nom <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.nom, {'attr': {'class': input_class, 'placeholder': 'Nom de famille'}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">
                                Prénom(s) <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.prenoms, {'attr': {'class': input_class, 'placeholder': 'Prénom(s)'}}) }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if not is_edit_page %}
                <section class="p-5 border border-orange-200 rounded-xl bg-orange-50">
                    <h3 class="flex items-center mb-4 text-base font-semibold text-orange-800">
                        <i class="mr-2 fas fa-user-edit"></i>
                        Informations personnelles
                    </h3>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Nom <span class="text-red-500">*</span></label>
                            {{ form_widget(form.nom, {'attr': {'class': input_class, 'placeholder': 'Nom de famille'}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Prénom(s) <span class="text-red-500">*</span></label>
                            {{ form_widget(form.prenoms, {'attr': {'class': input_class, 'placeholder': 'Prénom(s)'}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Adresse e-mail <span class="text-red-500">*</span></label>
                            {{ form_widget(form.email, {'attr': {'class': input_class, 'placeholder': 'exemple@domaine.com'}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Téléphone / WhatsApp <span class="text-red-500">*</span></label>
                            {{ form_widget(form.contact, {'attr': {'class': input_class, 'placeholder': 'Numéro de téléphone'}}) }}
                        </div>
                        <div class="md:col-span-2">
                            <label class="block mb-1 text-sm font-medium text-slate-700">Statut professionnel <span class="text-red-500">*</span></label>
                            {{ form_widget(form.etucom, {'attr': {'class': input_class, 'placeholder': 'Ex. Sans emploi, étudiant(e), salarié(e)...'}}) }}
                        </div>
                    </div>

                    <div class="pt-8 mt-6 border-t border-orange-200">
                        <h4 class="flex items-center mb-4 text-sm font-semibold text-orange-800">
                            <i class="mr-2 fas fa-map-marker-alt"></i>
                            Résidence actuelle
                        </h4>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div>
                                <label class="block mb-1 text-sm font-medium text-slate-700">Ville de résidence <span class="text-red-500">*</span></label>
                                {{ form_widget(form.villeResidence, {'attr': {'class': input_class}}) }}
                            </div>
                            <div>
                                <label class="block mb-1 text-sm font-medium text-slate-700">Quartier / Adresse précise <span class="text-red-500">*</span></label>
                                {{ form_widget(form.quartierAdresse, {'attr': {'class': input_class, 'placeholder': 'Ex. Quartier Commerce, Rue des Lys...'}}) }}
                            </div>
                        </div>
                    </div>
                </section>
            {% endif %}

            <!-- SECTION 1: TOUS LES UTILISATEURS - Formation souhaitée -->
            <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold text-indigo-800 border-b">
                <div class="flex items-center justify-center w-8 h-8 mr-3 bg-indigo-200 rounded-lg">
                    <i class="text-indigo-700 fas fa-graduation-cap"></i>
                </div>
                Formation souhaitée
            </h3>
            
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                    <label class="block mb-1 text-sm font-medium text-slate-700">
                        Établissement <span class="text-red-500">*</span>
                    </label>
                    {% if is_edit_page and candidature is defined and candidature.etablissement %}
                        {# En mode édition : établissement fixe (lecture seule) #}
                        <div class="{{ input_class }} bg-slate-100 text-slate-600 cursor-default flex items-center gap-2">
                            <i class="text-xs fas fa-lock text-slate-400"></i>
                            {{ candidature.etablissement.nom }}
                        </div>
                        {# Champ caché pour maintenir la valeur lors de la soumission #}
                        {{ form_widget(form.etablissement, {'attr': {'class': 'hidden', 'id': 'candidature_etablissement'}}) }}
                    {% else %}
                        {{ form_widget(form.etablissement, {'attr': {'class': input_class, 'id': 'candidature_etablissement'}}) }}
                    {% endif %}
                    <div id="etablissement-loading" class="hidden mt-1 text-sm text-indigo-600">
                        <i class="mr-1 fas fa-spinner fa-spin"></i> Chargement...
                    </div>
                </div>
                
                <div>
                    <label class="block mb-1 text-sm font-medium text-slate-700">
                        Métier <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.metier, {'attr': {'class': input_class, 'id': 'candidature_metier'}}) }}
                    <div id="metier-loading" class="hidden mt-1 text-sm text-indigo-600">
                        <i class="mr-1 fas fa-spinner fa-spin"></i> Chargement...
                    </div>
                </div>
            </div>

            <!-- Informations détaillées du métier -->
            <div id="metier-info" class="hidden mt-6">
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
                    <div class="flex items-center gap-3 p-2 bg-purple-100 rounded-lg">
                        <i class="text-purple-600 fas fa-users"></i>
                        <div>
                            <p class="text-xs text-purple-600">Places</p>
                            <p id="metier-nbrplace" class="text-sm font-medium">-</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-2 bg-green-100 rounded-lg">
                        <i class="text-green-600 fas fa-graduation-cap"></i>
                        <div>
                            <p class="text-xs text-green-600">Niveau</p>
                            <p id="metier-niveau" class="text-sm font-medium">-</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-2 rounded-lg bg-amber-100">
                        <i class="fas fa-clock text-amber-600"></i>
                        <div>
                            <p class="text-xs text-amber-600">Durée de formation</p>
                            <p id="metier-duree" class="text-sm font-medium">-</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: DOCUMENTS -->
            <h3 class="flex items-center pb-3 mt-8 mb-5 text-lg font-semibold text-purple-800 border-b">
                <div class="flex items-center justify-center w-8 h-8 mr-3 bg-purple-200 rounded-lg">
                    <i class="text-purple-700 fas fa-cloud-upload-alt"></i>
                </div>
                Documents à télécharger
            </h3>
            
            {% include 'partials/_document_upload.html.twig' with {
                'form': form,
                'document_labels': document_labels,
                'input_class': input_class
            } %}

            <!-- SECTION 3: POUR ENT ET ADMIN - Étude de dossier -->
            {% if is_granted('ROLE_ENT') or is_granted('ROLE_ADMIN') %}
                <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold border-b text-amber-800">
                    <div class="flex items-center justify-center w-8 h-8 mr-3 rounded-lg bg-amber-200">
                        <i class="fas fa-clipboard-check text-amber-700"></i>
                    </div>
                    Étude de dossier (ENT)
                </h3>
                
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Statut dossier</label>
                        {{ form_widget(form.etustatut, {'attr': {'class': input_class}}) }}
                    </div>
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Commentaire</label>
                        {{ form_widget(form.etucom, {'attr': {'class': input_class, 'placeholder': 'Commentaire sur le dossier...'}}) }}
                    </div>
                </div>
            {% endif %}

            <!-- SECTION 4: POUR JURY, ENT ET ADMIN - Évaluation entretien -->
            {% if is_granted('ROLE_JURY') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') %}
                <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold text-blue-800 border-b">
                    <div class="flex items-center justify-center w-8 h-8 mr-3 bg-blue-200 rounded-lg">
                        <i class="text-blue-700 fas fa-microphone-alt"></i>
                    </div>
                    Évaluation entretien
                </h3>
                
                <div class="grid grid-cols-1 gap-4 mb-4 md:grid-cols-2">
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Date entretien</label>
                        {{ form_widget(form.entdate, {'attr': {'class': input_class}}) }}
                    </div>
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Lieu entretien</label>
                        {{ form_widget(form.entlieu, {'attr': {'class': input_class, 'placeholder': 'Ex: Salle 101'}}) }}
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 mb-4 md:grid-cols-3">
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Numéro du jury</label>
                        {{ form_widget(form.jury, {'attr': {'class': input_class, 'min': 1, 'max': 20}}) }}
                    </div>
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Vague</label>
                        {{ form_widget(form.vague, {'attr': {'class': input_class, 'min': 1}}) }}
                    </div>
                    <div>
                        <label class="block mb-1 text-sm font-medium text-slate-700">Présence à l'entretien</label>
                        {{ form_widget(form.entstatut, {'attr': {'class': input_class}}) }}
                        <p class="mt-1 text-xs text-slate-400">1 = présent, vide = absent</p>
                    </div>
                </div>

                {% if form.note1 is defined %}
                <div class="grid grid-cols-1 gap-4 mb-6 md:grid-cols-2 lg:grid-cols-3">
                    {% for i in 1..13 %}
                        {% if attribute(form, 'note' ~ i) is defined %}
                            <div>
                                <label class="block mb-1 text-sm font-bold text-slate-700">
                                    {{ attribute(form, 'note' ~ i).vars.label }}
                                    <span class="text-xs font-normal text-slate-400">(Max: {{ attribute(form, 'note' ~ i).vars.attr['data-max'] }})</span>
                                </label>
                                {{ form_widget(attribute(form, 'note' ~ i), {'attr': {'class': input_class ~ ' note-input'}}) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                {# Affichage du Total et de la Moyenne #}
                <div class="grid grid-cols-1 gap-4 p-4 mb-6 border md:grid-cols-2 bg-slate-50 rounded-xl border-slate-200">
                    <div class="text-center">
                        <p class="text-sm font-semibold text-slate-600">TOTAL</p>
                        <p id="total-display" class="text-2xl font-bold text-indigo-700">0 / 40</p>
                    </div>
                    <div class="text-center">
                        <p class="text-sm font-semibold text-slate-600">MOYENNE</p>
                        <p id="moyenne-display" class="text-2xl font-bold text-purple-700">0 / 4</p>
                    </div>
                </div>

                {# DÉCISION DU JURY — centrée sous le Total/Moyenne #}
                <div class="flex justify-center mb-6">
                    <div class="w-full max-w-md p-5 border border-blue-200 shadow-sm bg-blue-50 rounded-xl">
                        <label class="block mb-2 text-sm font-bold text-center text-blue-800">
                            <i class="mr-1 fas fa-gavel"></i> Décision du jury
                        </label>
                        {{ form_widget(form.decisionJury, {'attr': {'class': input_class ~ ' text-center font-semibold text-blue-800'}}) }}
                        <p class="mt-2 text-xs text-center text-slate-500">
                            À saisir manuellement par le jury (voir moyenne calculée ci-dessus)
                        </p>
                    </div>
                </div>
                {% endif %}

                <div class="mt-4 mb-6">
                    <label class="block mb-1 text-sm font-medium text-slate-700">Commentaire entretien</label>
                    {{ form_widget(form.entcom, {'attr': {'class': input_class, 'rows': 3, 'placeholder': "Observations sur l'entretien..."}}) }}
                </div>
            {% endif %}


            <!-- SECTION 5: Visite médicale et résultat final -->
            {% if is_granted('ROLE_ENT') or is_granted('ROLE_JURY') or is_granted('ROLE_ADMIN') %}
                <div class="p-6 border bg-emerald-50 rounded-2xl border-emerald-200">
                    <h3 class="flex items-center pb-3 mb-5 text-lg font-semibold border-b text-emerald-800 border-emerald-200">
                        <div class="flex items-center justify-center w-8 h-8 mr-3 rounded-lg bg-emerald-200">
                            <i class="fas fa-hospital text-emerald-700"></i>
                        </div>
                        VISITE MÉDICALE & Résultat final
                    </h3>
                    
                    <div class="grid grid-cols-1 gap-4 mb-4 md:grid-cols-2">
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Date visite</label>
                            {{ form_widget(form.visdate, {'attr': {'class': input_class}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Lieu visite</label>
                            {{ form_widget(form.vislieu, {'attr': {'class': input_class, 'placeholder': 'Ex: Centre médical'}}) }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Statut visite</label>
                            {{ form_widget(form.visstatut, {'attr': {'class': input_class}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Résultat final</label>
                            {{ form_widget(form.resultat, {'attr': {'class': input_class}}) }}
                        </div>
                        <div>
                            <label class="block mb-1 text-sm font-medium text-slate-700">Commentaire</label>
                            {{ form_widget(form.viscom, {'attr': {'class': input_class, 'placeholder': 'Commentaire visite...'}}) }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if not is_edit_page %}
                <div class="p-5 border border-indigo-200 rounded-xl bg-indigo-50">
                    <label class="flex items-start gap-3 mt-4 text-sm text-slate-700">
                        {{ form_widget(form.declarationHonneur, {'attr': {'class': 'mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded'}}) }}
                        <span>{{ form_label(form.declarationHonneur) }}</span>
                    </label>
                    {{ form_errors(form.declarationHonneur) }}
                </div>
            {% endif %}

            {{ form_rest(form) }}

            <!-- Boutons d'action -->
            <div class="flex flex-col items-center justify-between gap-4 pt-6 border-t md:flex-row border-slate-200">
                <div class="text-sm text-slate-500">
                    <i class="mr-1 fas fa-info-circle"></i>
                    Les champs marqués d'une <span class="text-red-500">*</span> sont obligatoires
                </div>
                
                <div class="flex gap-3">
                    {% if app.user %}
                        {# Vérification de l'âge pour afficher/masquer le bouton de soumission #}
                        {% set age = app.user.datenaissance ? date().diff(date(app.user.datenaissance)).y : null %}
                        
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY') %}
                            {# Les rôles admin/ent/jury peuvent toujours soumettre #}
                            <button type="submit" class="flex items-center px-8 py-2 font-semibold text-white transition transform rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 hover:scale-105">
                                <i class="mr-2 fas fa-paper-plane"></i>
                                Enregistrer l'évaluation
                            </button>
                        {% elseif age >= 18 and age <= 40 %}
                            {# Candidat avec âge valide #}
                            <button type="submit" class="flex items-center px-8 py-2 font-semibold text-white transition transform rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 hover:scale-105">
                                <i class="mr-2 fas fa-paper-plane"></i>
                                Soumettre ma candidature
                            </button>
                        {% else %}
                            {# Candidat avec âge invalide - bouton désactivé #}
                            <button type="button" disabled class="flex items-center px-8 py-2 font-semibold text-white bg-gray-400 rounded-lg opacity-50 cursor-not-allowed" title="Vous ne remplissez pas les conditions d'âge">
                                <i class="mr-2 fas fa-ban"></i>
                                Soumission impossible
                            </button>
                        {% endif %}
                    {% else %}
                        {% set redirectUrl = path('app_candidature_new', {
                            'etablissement': app.request.get('etablissement'),
                            'metier': app.request.get('metier')
                        }) %}
                        
                        <a href="{{ path('app_login', {'redirect': redirectUrl}) }}" 
                           class="flex items-center px-8 py-2 font-semibold text-white transition transform rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 hover:scale-105">
                            <i class="mr-2 fas fa-sign-in-alt"></i>
                            Se connecter pour postuler
                        </a>
                    {% endif %}
                </div>
            </div>

            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </div>

    {% endif %}
</div>

<!-- JavaScript pour la gestion dynamique établissement/métier -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const etablissementSelect = document.getElementById('candidature_etablissement');
    const metierSelect = document.getElementById('candidature_metier');
    const metierInfo = document.getElementById('metier-info');
    const metierNiveau = document.getElementById('metier-niveau');
    const metierNbrPlace = document.getElementById('metier-nbrplace');
    const metierDuree = document.getElementById('metier-duree');
    const etablissementLoading = document.getElementById('etablissement-loading');
    const metierLoading = document.getElementById('metier-loading');
    
    const currentMetierValue = metierSelect.value;

    function loadMetiers(etablissementId, callback) {
        if (!etablissementId) {
            metierSelect.innerHTML = '<option value="">-- Choisissez d\'abord un établissement --</option>';
            metierSelect.disabled = true;
            metierInfo.classList.add('hidden');
            if (callback) callback();
            return;
        }

        metierLoading.classList.remove('hidden');
        metierSelect.disabled = true;

        const url = "{{ path('app_candidature_etablissement_metiers', {'id': 'PLACEHOLDER'}) }}".replace('PLACEHOLDER', etablissementId);
        fetch(url)
            .then(response => response.json())
            .then(data => {
                metierSelect.innerHTML = '<option value="">-- Sélectionnez un métier --</option>';
                
                // Tri par nom de métier
                data.sort((a, b) => a.nom.localeCompare(b.nom));

                data.forEach(metier => {
                    const option = document.createElement('option');
                    option.value = metier.id;
                    option.dataset.niveau = metier.niveau || '';
                    option.dataset.duree = metier.duree || '';
                    option.dataset.nbrplace = metier.nbrplace || '';
                    
                    let label = metier.nom;
                    if (metier.nbrplace) {
                        label += ' (' + metier.nbrplace + ' places)';
                    }
                    option.textContent = label;
                    metierSelect.appendChild(option);
                });
                
                const metierToSelect = currentMetierValue || '{{ app.request.get('metier')|default('') }}';
                
                if (metierToSelect) {
                    const options = metierSelect.options;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i].value == metierToSelect) {
                            options[i].selected = true;
                            updateMetierInfo(options[i]);
                            break;
                        }
                    }
                }
                
                metierSelect.disabled = false;
                metierLoading.classList.add('hidden');
                
                if (callback) callback();
            })
            .catch(error => {
                console.error('Erreur:', error);
                metierSelect.disabled = false;
                metierLoading.classList.add('hidden');
                if (callback) callback();
            });
    }

    function updateMetierInfo(selectedOption) {
        if (!selectedOption || !selectedOption.value) {
            metierInfo.classList.add('hidden');
            return;
        }
        
        metierNiveau.textContent = selectedOption.dataset.niveau || 'Non spécifié';
        metierDuree.textContent = selectedOption.dataset.duree || 'Non spécifié';
        metierNbrPlace.textContent = selectedOption.dataset.nbrplace || 'Non spécifié';
        metierInfo.classList.remove('hidden');
    }

    {% if app.request.get('etablissement') %}
        const etablissementId = '{{ app.request.get('etablissement') }}';
        if (etablissementId) {
            setTimeout(function() {
                const options = etablissementSelect.options;
                for (let i = 0; i < options.length; i++) {
                    if (options[i].value == etablissementId) {
                        options[i].selected = true;
                        break;
                    }
                }
                loadMetiers(etablissementId);
            }, 100);
        }
    {% else %}
        if (etablissementSelect.value) {
            loadMetiers(etablissementSelect.value);
        } else {
            metierSelect.innerHTML = '<option value="">-- Choisissez d\'abord un établissement --</option>';
            metierSelect.disabled = true;
        }
    {% endif %}

    etablissementSelect.addEventListener('change', function() {
        loadMetiers(this.value);
        metierInfo.classList.add('hidden');
    });

    metierSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        updateMetierInfo(selectedOption);
    });

    const form = document.getElementById('candidature-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            {% if not app.user %}
            e.preventDefault();
            alert('Vous devez être connecté pour soumettre une candidature.');
            const redirectUrl = '/candidature/new?etablissement=' + etablissementSelect.value + '&metier=' + metierSelect.value;
            window.location.href = '/login?redirect=' + encodeURIComponent(redirectUrl);
            return false;
            {% endif %}

            {% if app.user and app.user.datenaissance %}
                {% set age = date().diff(date(app.user.datenaissance)).y %}
                {% if age < 18 or age > 40 %}
                    e.preventDefault();
                    alert('Vous ne remplissez pas les conditions d\'âge pour candidater (18 à 40 ans).');
                    return false;
                {% endif %}
            {% endif %}

            if (!etablissementSelect.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un établissement.');
                return false;
            }
            
            if (!metierSelect.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un métier.');
                return false;
            }
        });
    }
});
</script>

<!-- Javascript : calcul du total et de la moyenne (affichage uniquement) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const noteInputs = document.querySelectorAll('.note-input');
    const totalDisplay = document.getElementById('total-display');
    const moyenneDisplay = document.getElementById('moyenne-display');

    function calculerNotes() {
        let total = 0;

        noteInputs.forEach(input => {
            const val = parseFloat(input.value) || 0;
            total += val;
        });

        const totalMax = 40;
        const moyenne = (total / totalMax) * 4;

        if (totalDisplay) totalDisplay.textContent = total.toFixed(2).replace(/\.00$/, '') + ' / ' + totalMax;
        if (moyenneDisplay) moyenneDisplay.textContent = moyenne.toFixed(2).replace(/\.00$/, '') + ' / 4';
    }

    noteInputs.forEach(input => {
        input.addEventListener('input', calculerNotes);
        input.addEventListener('change', calculerNotes);
    });

    if (noteInputs.length > 0) {
        calculerNotes();
    }
});
</script>

{% endblock %}