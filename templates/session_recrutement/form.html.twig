{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ session.id ? 'Modifier la session' : 'Nouvelle session' }} | {{ parent() }}{% endblock %}

{% set input_class = 'w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition' %}

{% block body %}
<div class="mx-auto">
    <div class="p-8 mb-8 text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl">
        <div class="flex items-center gap-4">
            <div class="flex items-center justify-center w-16 h-16 rounded-full bg-white/20">
                <i class="text-3xl fas fa-calendar-alt"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold">{{ session.id ? 'Modifier la session' : 'Nouvelle session de recrutement' }}</h1>
                <p class="text-white/80">Configurez la campagne de recrutement du GROUPE LEMETIER</p>
            </div>
        </div>
    </div>

    {% include 'partials/_flash_messages.html.twig' %}

    <div class="p-8 overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="md:col-span-2">
                <label class="block mb-1 text-sm font-medium text-slate-700">Nom de la session <span class="text-red-500">*</span></label>
                {{ form_widget(form.nom, {'attr': {'class': input_class, 'placeholder': 'Ex. Session 2026 - Vague 1'}}) }}
                {{ form_errors(form.nom) }}
            </div>
            <div>
                <label class="block mb-1 text-sm font-medium text-slate-700">Année <span class="text-red-500">*</span></label>
                {{ form_widget(form.annee, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.annee) }}
            </div>
            <div>
                <label class="block mb-1 text-sm font-medium text-slate-700">N° de vague <span class="text-red-500">*</span></label>
                {{ form_widget(form.numeroVague, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.numeroVague) }}
                <p class="mt-1 text-xs text-slate-400">
                    Sert à la gestion de la session ; ce numéro ne figure pas dans le numéro de candidature.
                </p>
            </div>
            <div>
                <label class="block mb-1 text-sm font-medium text-slate-700">Statut <span class="text-red-500">*</span></label>
                {{ form_widget(form.statut, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.statut) }}
            </div>
            <div>
                <label class="block mb-1 text-sm font-medium text-slate-700">Ouverture des inscriptions</label>
                {{ form_widget(form.dateOuverture, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.dateOuverture) }}
            </div>
            <div>
                <label class="block mb-1 text-sm font-medium text-slate-700">Clôture des inscriptions</label>
                {{ form_widget(form.dateCloture, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.dateCloture) }}
            </div>
            <div class="p-4 border border-indigo-100 rounded-lg md:col-span-2 bg-indigo-50/50">
                <label class="block mb-2 text-sm font-medium text-slate-700">Session active</label>
                <div class="flex gap-6 text-sm text-slate-700">{{ form_widget(form.active) }}</div>
                {{ form_errors(form.active) }}
            </div>
            <div class="md:col-span-2">
                <label class="block mb-1 text-sm font-medium text-slate-700">Description</label>
                {{ form_widget(form.description, {'attr': {'class': input_class, 'rows': 5, 'placeholder': 'Présentez les objectifs et les modalités de la session.'}}) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-slate-200">
            <a href="{{ path('app_session_recrutement_index') }}" class="inline-flex items-center px-6 py-2 transition border rounded-lg border-slate-300 text-slate-700 hover:bg-slate-50"><i class="mr-2 fas fa-times"></i>Annuler</a>
            <button type="submit" class="inline-flex items-center px-6 py-2 font-semibold text-white transition rounded-lg shadow-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700"><i class="mr-2 fas fa-save"></i>{{ session.id ? 'Modifier' : 'Enregistrer' }}</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
