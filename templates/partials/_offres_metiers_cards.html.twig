{# Cartes « Métiers et places » de l'accueil. data-places / data-lieu alimentent le filtre par lycée (assets/home.js). #}
<div class="grid gap-4 mt-8 sm:gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-list>
    {% for offre in offresMetiers %}
        <article data-metier data-reveal-item data-total="{{ offre.nbrplace }}" data-places="{{ offre.parLycee|json_encode }}"
                 class="overflow-hidden text-slate-900 bg-white rounded-[18px] card-lift">
            <button type="button" data-open-dialog="metier-{{ offre.id }}"
                    onclick="document.getElementById('metier-{{ offre.id }}').showModal()"
                    aria-haspopup="dialog" aria-controls="metier-{{ offre.id }}"
                    class="flex w-full h-full text-left sm:flex-col focus:outline-none focus-visible:ring-4 focus-visible:ring-orange-300">
                {# Téléphone : carte horizontale compacte ; à partir de 640 px : image au-dessus #}
                {% if offre.image %}
                    <img src="{{ asset('uploads/metiers/' ~ offre.image) }}" alt="" width="640" height="480" loading="lazy" decoding="async"
                         class="block flex-shrink-0 object-cover object-top w-28 min-h-[7rem] self-stretch sm:w-full sm:min-h-0 sm:self-auto sm:aspect-[4/3] bg-slate-200">
                {% else %}
                    <span class="flex items-center justify-center flex-shrink-0 text-4xl text-indigo-200 bg-indigo-900 w-28 sm:w-full aspect-square sm:aspect-[4/3]" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
                {% endif %}
                <span class="flex flex-col flex-1 min-w-0 gap-2 px-4 pt-3.5 pb-3.5 sm:gap-2.5 sm:pt-4 sm:pb-4">
                    <span class="text-base font-extrabold leading-snug sm:text-lg">{{ offre.nomMetier }}</span>
                    <span class="flex items-center gap-2 text-[15px] text-slate-600">
                        <i class="text-green-600 fas fa-user-group" aria-hidden="true"></i>
                        <strong class="text-slate-900 tabular-nums" data-metier-total>{{ offre.nbrplace }}</strong> places
                    </span>
                    <span class="grid gap-1.5 pt-3 mt-auto text-sm border-t border-slate-200">
                        {% for lieu in offre.etablissements %}
                            <span data-lieu="{{ lieu.code }}" class="flex justify-between gap-2">
                                <span class="text-slate-700"><span class="font-bold text-indigo-700">{{ lieu.code }}</span> · {{ lieu.localite }}</span>
                                <span class="font-bold tabular-nums">{{ lieu.nbrplace }}</span>
                            </span>
                        {% endfor %}
                    </span>
                    <span class="text-xs font-semibold text-indigo-600">Voir la fiche du métier <i class="ml-1 fas fa-arrow-right" aria-hidden="true"></i></span>
                </span>
            </button>
        </article>

        {# Fiche : en-tête et boutons fixes, contenu défilant — jamais plus haute que l'écran #}
        <dialog id="metier-{{ offre.id }}" aria-labelledby="metier-{{ offre.id }}-titre" data-lenis-prevent
                class="metier-dialog w-[calc(100%-2rem)] max-w-xl max-h-[calc(100dvh-2rem)] p-0 bg-white shadow-2xl rounded-2xl text-slate-900 open:flex open:flex-col">
            <div class="flex items-start justify-between flex-shrink-0 gap-4 p-5 border-b border-slate-200">
                <h3 id="metier-{{ offre.id }}-titre" class="text-2xl font-extrabold">{{ offre.nomMetier }}</h3>
                <button type="button" onclick="this.closest('dialog').close()" aria-label="Fermer"
                        class="flex items-center justify-center rounded-full w-11 h-11 text-slate-500 hover:bg-slate-100">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="flex-1 min-h-0 p-5 space-y-5 overflow-y-auto overscroll-contain">
                {% if offre.image %}
                    <img src="{{ asset('uploads/metiers/' ~ offre.image) }}" alt="" width="640" height="480" loading="lazy"
                         class="object-cover object-top w-full h-36 sm:h-48 rounded-xl">
                {% endif %}
                <p class="leading-relaxed text-slate-700">{{ offre.description ?: 'La description de ce métier sera bientôt disponible.' }}</p>
                <div>
                    <h4 class="text-sm font-bold">Où se former ?</h4>
                    <ul class="mt-2 space-y-2">
                        {% for lieu in offre.etablissements %}
                            <li class="flex items-center justify-between gap-3 p-3 border rounded-xl border-slate-200">
                                <span><strong>{{ lieu.nom }} ({{ lieu.code }})</strong><span class="block text-sm text-slate-600">{{ lieu.localite }}</span></span>
                                <span class="font-bold text-indigo-700 tabular-nums whitespace-nowrap">{{ lieu.nbrplace }} places</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="flex flex-col flex-shrink-0 gap-3 p-5 border-t sm:flex-row sm:justify-end border-slate-200">
                <button type="button" onclick="this.closest('dialog').close()"
                        class="px-4 py-2.5 font-medium border rounded-xl text-slate-700 border-slate-300 hover:bg-slate-50">Fermer</button>
                <a href="#ou-sinscrire" onclick="this.closest('dialog').close()"
                   class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-lg font-bold text-white rounded-xl bg-gradient-to-r from-orange-300 to-orange-500 transition hover:from-orange-400 hover:to-orange-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300">
                    <i class="fas fa-location-dot" aria-hidden="true"></i> Où m’inscrire ?
                </a>
            </div>
        </dialog>
    {% else %}
        <p class="py-10 text-center col-span-full text-white/80">Aucune offre de formation n’est disponible pour le moment.</p>
    {% endfor %}
</div>
